HOST=127.0.0.1
PORT=4000
AGENT_DATA_DIR=./data
# Defaults to the skills directory next to src/ or dist/.
# AGENT_SKILLS_DIR=/absolute/path/to/skills
AGENT_MAX_MODEL_CALLS=40
AGENT_MAX_TOOL_CALLS=60
AGENT_IDLE_TIMEOUT_MS=120000
AGENT_RUN_TIMEOUT_MS=900000
AGENT_FIRST_EVENT_WAIT_MS=15000
AGENT_SESSION_TTL_HOURS=168
# Attachments: PDF/PNG/JPEG/WebP, up to 3 per turn and 10 MiB each.
AGENT_ATTACHMENT_TTL_HOURS=24
# Optional stable signing secret (at least 32 characters); otherwise random per process.
# AGENT_ATTACHMENT_SECRET=
AGENT_MAX_SEARCHES=5
AGENT_BODY_LIMIT_BYTES=2097152
# Local model/search endpoints are permitted only outside NODE_ENV=production.
AGENT_ALLOW_PRIVATE_MODEL_HOSTS=false

# Search is absent unless one provider has complete configuration.
# Tavily: default base https://api.tavily.com (appends /search).
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=
# Brave alternative: default base https://api.search.brave.com/res/v1.
# SEARCH_PROVIDER=brave
# SEARCH_API_KEY=
# SearXNG alternative: your own instance; JSON output must be enabled.
# SEARCH_PROVIDER=searxng
# SEARCH_BASE_URL=http://127.0.0.1:8080
# Private instances also need the non-production opt-in above.

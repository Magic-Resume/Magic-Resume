# Public landing URL, used for canonical URLs and sitemap output.
SITE_URL=https://www.magic-resume.cn

# Real web app origin. Landing CTAs will point to `${PUBLIC_WEB_ORIGIN}/dashboard`.
# Leave empty when landing and web are served from the same origin.
PUBLIC_WEB_ORIGIN=https://app.magic-resume.cn

# Optional public API used by the build-time content sync. When empty, the
# checked-in editorial seed articles are used and a build never depends on a
# running backend.
PUBLIC_CONTENT_API_URL=

# Optional docs site origin. Leave empty until the Mintlify deployment has a
# stable canonical hostname.
PUBLIC_DOCS_ORIGIN=

---
/**
 * JSON-LD for the landing page.
 *
 * Built from copy that already exists on the page:
 *
 *   FAQPage           — mirrors the visible FAQ accordion verbatim. Google
 *                       requires the marked-up answer to be the one the user
 *                       actually sees, so this reads from the same `copy.faq`
 *                       the component renders. Never hand-write a second copy.
 *   SoftwareApplication — what the product is, in the page's own language.
 *   Organization      — the publisher, under the shared ORGANIZATION_ID that
 *                       content pages and the docs site use as well.
 *   SoftwareSourceCode — the MIT-licensed repository behind the product.
 *
 * Deliberately absent:
 *
 *   aggregateRating — we have no review corpus. Inventing ratings is a Google
 *                     spam-policy violation and is dishonest besides.
 *   sameAs          — only verified, real URLs belong here; the GitHub repo
 *                     comes from `consts.ts` rather than being retyped.
 */
import type { Copy, Locale } from '@/i18n/ui';
import { pricingSchema, type PricingResult } from '@/data/pricing';
import { loadSoftwareVersion } from '@/data/software-version';
import { GITHUB, ORGANIZATION_ID } from '@/consts';

interface Props {
  copy: Copy;
  pricing: PricingResult;
  locale: Locale;
  canonical: string;
  siteUrl: string;
  ogImage: string;
}
const { copy, locale, canonical, siteUrl, ogImage, pricing } = Astro.props;

const softwareVersion = await loadSoftwareVersion();

const inLanguage = locale === 'zh' ? 'zh-CN' : 'en';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage,
  mainEntity: copy.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const softwareId = `${siteUrl.replace(/\/$/, '')}/#software`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: 'Magic Resume',
  url: siteUrl,
  logo: new URL('/magic-resume-mark.png', siteUrl).href,
  sameAs: [GITHUB.repo],
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': softwareId,
  ...pricingSchema(pricing),
  ...(softwareVersion ? { softwareVersion } : {}),
  name: 'Magic Resume',
  url: canonical,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: copy.meta.description,
  inLanguage,
  image: ogImage,
  author: { '@id': ORGANIZATION_ID },
  publisher: { '@id': ORGANIZATION_ID },
  license: 'https://opensource.org/licenses/MIT',
  // First commit. No `dateModified`: it would have to be the build timestamp,
  // which claims the content changed every time we redeploy — a freshness
  // signal we would be manufacturing rather than reporting.
  datePublished: '2025-06-05',
  sameAs: [GITHUB.repo],
};

const sourceSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Magic Resume',
  codeRepository: GITHUB.repo,
  license: 'https://opensource.org/licenses/MIT',
  programmingLanguage: 'TypeScript',
  author: { '@id': ORGANIZATION_ID },
  targetProduct: { '@id': softwareId },
};

/**
 * `</script>` inside a JSON string would terminate the script element early.
 * Our copy contains no markup today, but escaping `<` costs nothing and means
 * a future FAQ answer mentioning an HTML tag cannot break the page.
 */
const serialize = (data: unknown) =>
  JSON.stringify(data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={serialize(faqSchema)} />
<script type="application/ld+json" is:inline set:html={serialize(organizationSchema)} />
<script type="application/ld+json" is:inline set:html={serialize(appSchema)} />
<script type="application/ld+json" is:inline set:html={serialize(sourceSchema)} />

---
import type { Copy } from '@/i18n/ui';
import SectionHeading from '@/components/landing-ui/SectionHeading.astro';
interface Props { copy: Copy; }
const { copy } = Astro.props;
const f = copy.faq;
---
<section id="faq" class="be-section be-faq" data-beui="faq-numbered">
  <div class="be-container"><SectionHeading {...f} subtitle={copy.landing.faqSubtitle} centered/>
    <faq-list class="be-numbered-list reveal">
      {f.items.map((item,i) => <details class="be-faq-item" open={i === 0}><summary><span class="be-index">{String(i+1).padStart(2,'0')}</span><h3>{item.q}</h3><span class="be-faq-icon" aria-hidden="true"><i></i><i></i></span></summary><div class="be-faq-answer"><div><p>{item.a}</p></div></div></details>)}
    </faq-list>
  </div>
</section>

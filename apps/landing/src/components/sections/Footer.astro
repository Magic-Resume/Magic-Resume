---
import type { Copy, Locale } from '@/i18n/ui';
import { dashboardLink, GITHUB, CONTACT_EMAIL } from '@/consts';
import { interpolate } from '@/i18n/ui';
interface Props { copy: Copy; locale: Locale; base?: string; }
const { copy, locale, base = '' } = Astro.props;
const f = copy.footer;
---
<footer class="be-footer" data-beui="footer-spotlight">
  <div class="be-container">
    <div class="be-footer-grid"><div class="be-footer-brand"><a class="landing-brand" href={`${base}#top`}><img src="/magic-resume-mark.png" alt="" width="28" height="28"/><span>Magic Resume</span></a><p>{f.brandSubtitle}</p><a class="be-text-link" href={`mailto:${CONTACT_EMAIL}`}>{locale === 'zh' ? '联系我们' : 'Say hello'}<span aria-hidden="true">↗</span></a><small>{interpolate(f.copyright,{year:new Date().getFullYear()})}</small></div>
      <div><h2>{f.product}</h2><a href={dashboardLink('footer',locale)} data-astro-reload>{f.builder}</a><a href={`${base}#features`}>{copy.nav.features}</a><a href={`${base}#pricing`}>{locale === 'zh' ? '套餐与定价' : 'Plans & pricing'}</a></div>
      <div><h2>{locale === 'zh' ? '资源' : 'Resources'}</h2><a href={`/${locale}/blog`}>{locale === 'zh' ? '求职文章' : 'Career guides'}</a><a href={`/${locale}/tools`}>{locale === 'zh' ? '简历工具' : 'Resume tools'}</a><a href={`${base}#faq`}>{copy.nav.faq}</a></div>
      <div><h2>{f.project}</h2><a href={GITHUB.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={GITHUB.issues} target="_blank" rel="noopener noreferrer">{f.issues} ↗</a><a href={GITHUB.contributors} target="_blank" rel="noopener noreferrer">{f.contributors} ↗</a></div>
    </div>
    <footer-spotlight class="be-footer-wordmark" aria-hidden="true"><span>Magic Resume</span><span class="be-wordmark-fill">Magic Resume</span></footer-spotlight>
  </div>
</footer>

---
import type { Copy } from '@/i18n/ui';
import SectionHeading from '@/components/landing-ui/SectionHeading.astro';
interface Props { copy: Copy; }
const { copy } = Astro.props;
const p = copy.landing.proof;
---
<section class="be-section be-proof-section" data-beui="stats-band">
  <div class="be-container">
    <div class="be-proof-head">
      <SectionHeading title={p.title} />
      <p class="be-proof-lede reveal">{p.subtitle}</p>
    </div>
    <div class="be-proof">
      {p.items.map((item, i) => <div class="be-proof-item reveal" style={`--reveal-delay:${i + 1}`}>
        <p class="be-index">{String(i + 1).padStart(2, '0')}<i aria-hidden="true"></i></p>
        <strong>{item.value}</strong>
        <h3>{item.label}</h3>
        <p class="be-proof-detail">{item.detail}</p>
      </div>)}
    </div>
  </div>
</section>

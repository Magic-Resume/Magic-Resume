---
import type { Copy, Locale } from '@/i18n/ui';
import { dashboardLink } from '@/consts';
import Icon from '@/components/Icon.astro';

interface Props {
  copy: Copy;
  locale: Locale;
}
const { copy, locale } = Astro.props;
const c = copy.cta;
---

<section class="relative overflow-hidden border-t border-hair py-28 md:py-36">
  <div
    aria-hidden="true"
    class="cta-bloom pointer-events-none absolute inset-x-0 bottom-0 h-[420px]"
  ></div>

  <div class="reveal relative mx-auto max-w-2xl px-5 text-center md:px-6">
    <h2 class="type-heading-lg text-ink">
      {c.title}
    </h2>
    <p class="type-body-lg mx-auto mt-5 max-w-lg text-muted">
      {c.subtitle}
    </p>
    <div class="mt-9 flex flex-col items-center gap-4">
      <a
        href={dashboardLink('cta_section', locale)}
        class="btn-accent group flex items-center gap-2 rounded-md px-7 py-3 text-[15px] font-w510"
      >
        {c.button}
        <Icon name="arrow-right" size={17} class="transition-transform group-hover:translate-x-0.5" />
      </a>
      <p class="text-[13px] text-muted">{c.note}</p>
    </div>
  </div>
</section>

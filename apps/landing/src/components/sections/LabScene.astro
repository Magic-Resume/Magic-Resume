---
import type { Copy } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';
interface Props { copy: Copy; }
const { copy } = Astro.props;
const f = copy.landing.features;
const icons = ['pen', 'sparkle', 'clipboard', 'languages', 'mic', 'download'] as const;
// tone 决定 hover 那层网格渐变的调色板(源站每张卡一个)。
const tones = ['peach', 'mint', 'violet', 'blue', 'amber', 'rose'] as const;
---
<section id="features" class="be-signal" data-beui="feature-sections-signal-grid">
  <div class="be-container">
    <header class="be-signal-heading reveal">
      <h2>{f.title.split('\n').map(line => <span>{line}</span>)}</h2>
      <p>{f.subtitle}</p>
    </header>
    <div class="be-signal-grid reveal">
      {['tl', 'tr', 'bl', 'br'].map(corner => <i class={`be-signal-tick is-${corner}`} aria-hidden="true"/>)}
      {f.items.map((item, i) => <signal-card class="be-signal-card" data-tone={tones[i]} style={`--signal-index:${i}`}>
        <span class="be-signal-shader" aria-hidden="true"><canvas></canvas></span>
        <span class="be-signal-veil" aria-hidden="true"></span>
        <span class="be-signal-icon"><Icon name={icons[i]} size={20}/></span>
        <h3>{item.title.split('\n').map(line => <span>{line}</span>)}</h3>
        <p>{item.desc}</p>
      </signal-card>)}
    </div>
  </div>
</section>

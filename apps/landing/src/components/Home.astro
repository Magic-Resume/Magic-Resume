---
import type { Locale } from '@/i18n/ui';
import { getCopy } from '@/i18n/ui';
import { getContributors, getStarCount } from '@/lib/github';
import Landing from '@/layouts/Landing.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import LabScene from '@/components/sections/LabScene.astro';
import Workflow from '@/components/sections/Workflow.astro';
import Sync from '@/components/sections/Sync.astro';
import OpenSource from '@/components/sections/OpenSource.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import Team from '@/components/sections/Team.astro';
import Footer from '@/components/sections/Footer.astro';
import ProofBand from '@/components/sections/ProofBand.astro';
import UseCases from '@/components/sections/UseCases.astro';
import Process from '@/components/sections/Process.astro';
import Pricing from '@/components/sections/Pricing.astro';
import { loadPricing } from '@/data/pricing';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getCopy(locale);
const [stars, contributors, plans] = await Promise.all([
  getStarCount(),
  getContributors(),
  loadPricing(copy, locale, import.meta.env.LANDING_PRICING_URL),
]);
---

<Landing
  locale={locale}
  title={copy.meta.title}
  description={copy.meta.description}
  copy={copy}
>
  <Header copy={copy} stars={stars} locale={locale} />
  <main id="main">
    <Hero copy={copy} locale={locale} />
    <ProofBand copy={copy} />
    <UseCases copy={copy} locale={locale} />
    <LabScene copy={copy} />
    <Workflow copy={copy} />
    <Process copy={copy} locale={locale} />
    <Sync copy={copy} />
    <Pricing copy={copy} locale={locale} plans={plans} />
    <OpenSource copy={copy} stars={stars} />
    <FaqSection copy={copy} />
    <Team copy={copy} contributors={contributors} />
  </main>
  <Footer copy={copy} locale={locale} />
</Landing>

<script>
  import '@/components/landing-ui/interactions';
</script>

# ============================================================
# Magic Resume – Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in the values.

# ------ Deployment Mode -----------------------------------------------
# self-hosted : Pure local editor, no login required, no backend needed.
# cloud       : Clerk auth + NestJS backend + cloud sync (magic-resume.cn)
NEXT_PUBLIC_APP_MODE=self-hosted

# ------ App URL -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------ Cloud mode only -----------------------------------------------
# Required when NEXT_PUBLIC_APP_MODE=cloud

# Clerk (https://clerk.com)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...

# ------ Backend (single API address) ----------------------------------
# ONE origin for the whole backend — the edge gateway, which routes by path
# prefix:
#   /api/(chat|graph|agent|pdf|translate|interview) → agent-service
#   everything else /api/                           → platform-api
# Dev: the backend serves this on :3110 (defaults to it if unset).
# Prod: the public gateway origin (nginx terminates TLS in front).
# NEXT_PUBLIC_API_URL=http://localhost:3110

# ------ Cloudflare R2 (avatar upload, cloud mode) ---------------------
# Server-side only — used by /api/uploads/avatar to store avatars in R2.
# Create an R2 API Token (Object Read & Write) in the Cloudflare dashboard to
# get the Access Key ID / Secret. Self-hosted mode never uses these (it embeds
# the avatar as a data: URL instead).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=magic-resume-assets
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev


# ============================================================
# Magic Resume – Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in the values. Everything is
# optional for editing: resumes are stored in IndexedDB without an account.
# Polaris needs the agent (apps/agent) and your own model API key.

# ------ Polaris (AI assistant) ------------------------------------------
# Server-only origin of the AI backend (without /api): the bundled agent in
# apps/agent (port 4000 by default) or anything implementing
# docs/reference/ai-backend.md.
# AI_BACKEND_URL=http://localhost:4000

# ------ App URL -------------------------------------------------------
# Public origin, used for robots.txt and the sitemap. APP_PUBLIC_URL is read
# at request time, so one image can serve several domains without a rebuild.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_PUBLIC_URL=https://resume.example.com

# ------ Help menu -----------------------------------------------------
# Link target for "Help center". The menu item is hidden when unset.
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com

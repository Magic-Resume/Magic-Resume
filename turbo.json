{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "11",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_DIST_DIR", "INDEXNOW_KEY"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".next-verify/**",
        "!.next-verify/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "i18n:check": {
      "outputs": ["scripts/i18n-logs/**"]
    },
    "@magic-resume/landing#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "INDEXNOW_KEY",
        "PUBLIC_CONTENT_API_URL",
        "PUBLIC_CONTENT_API_PATH",
        "PUBLIC_EXEMPLAR_API_PATH",
        "PUBLIC_CONTENT_API_TOKEN"
      ],
      "outputs": ["dist/**"]
    }
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "11",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_DIST_DIR", "INDEXNOW_KEY"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".next-verify/**",
        "!.next-verify/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@magic-resume/agent#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "HOST",
        "PORT",
        "AGENT_DATA_DIR",
        "AGENT_SKILLS_DIR",
        "AGENT_MAX_MODEL_CALLS",
        "AGENT_MAX_TOOL_CALLS",
        "AGENT_IDLE_TIMEOUT_MS",
        "AGENT_RUN_TIMEOUT_MS",
        "AGENT_FIRST_EVENT_WAIT_MS",
        "AGENT_SESSION_TTL_HOURS",
        "AGENT_BODY_LIMIT_BYTES",
        "AGENT_RATE_LIMIT_PER_MINUTE",
        "AGENT_ALLOW_PRIVATE_MODEL_HOSTS"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "i18n:check": {
      "outputs": ["scripts/i18n-logs/**"]
    },
    "@magic-resume/landing#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "INDEXNOW_KEY",
        "PUBLIC_CONTENT_API_URL",
        "PUBLIC_CONTENT_API_PATH",
        "PUBLIC_EXEMPLAR_API_PATH",
        "PUBLIC_CONTENT_API_TOKEN"
      ],
      "outputs": ["dist/**"]
    }
  }
}

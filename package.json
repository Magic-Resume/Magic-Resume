{
  "name": "magic-resume",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Magic-Resume/Magic-Resume.git"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.28.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && pnpm check:tailwind && pnpm check:turbo",
    "check:ui": "node scripts/check-ui-architecture.mjs",
    "test": "turbo test",
    "check:tailwind": "node scripts/check-tailwind-architecture.mjs",
    "check:turbo": "node scripts/check-turbo-architecture.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "npm run i18n:check --workspace @magic-resume/web"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.4"
  }
}
